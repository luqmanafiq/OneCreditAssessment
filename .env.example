# Any OpenAI-compatible endpoint. Copy to .env (which git ignores) and fill in.
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai
# Groq:    https://api.groq.com/openai/v1
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Check your provider's current free models.
LLM_MODEL=
# Seconds between calls, to stay under a free tier's per-minute limit.
LLM_MIN_INTERVAL=4
